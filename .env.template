# HOW TO USE:
# 1. Copy this file to `.env`.
# 2. Fill REQUIRED fields.
# 3. Restart services.
#
# SCOPE:
# Root `.env` is read by Docker Compose and shared infrastructure services.
# Backend runtime settings belong in `apps/backend/.env`.
# Frontend local Vite settings belong in `apps/frontend/.env`.
# Docker Compose also reads frontend public `VITE_*` values from `apps/frontend/.env`.
#
# SECURITY:
# Never commit populated `.env` files. Replace all `change_me` values before production.

# ===============================
# DATABASE
# ===============================

# REQUIRED | used in: docker-compose.yml (postgres service)
# Description: PostgreSQL username for the local Docker database.
POSTGRES_USER=user

# REQUIRED | used in: docker-compose.yml (postgres service)
# Description: PostgreSQL password for the local Docker database. Change in production.
POSTGRES_PASSWORD=password

# REQUIRED | used in: docker-compose.yml (postgres service)
# Description: PostgreSQL database name created by the local Docker database.
POSTGRES_DB=arogyaai

# ===============================
# AUTH / SECURITY
# ===============================

# REQUIRED | used in: apps/backend/core/config.py, apps/backend/core/security.py
# Description: Canonical JWT signing secret. Mirror this in `apps/backend/.env` for the backend runtime.
JWT_SECRET_KEY=change_me_use_a_long_random_value

# REQUIRED | used in: apps/backend/core/config.py, apps/backend/core/security.py
# Description: Encryption key for sensitive stored values. Mirror this in `apps/backend/.env`.
APP_ENCRYPTION_KEY=change_me_use_a_long_random_value

# ===============================
# GLOBAL SERVICES
# ===============================

# OPTIONAL | used in: apps/backend/services/health_service.py, apps/backend/core/celery_app.py
# Description: Redis URL for shared cache/readiness checks. Backend service env can override this.
REDIS_URL=redis://redis:6379/0

# OPTIONAL | used in: pipelines/rag_pipeline/config.py, pipelines/rag_pipeline/ingest.py
# Description: Qdrant vector database base URL for RAG indexing and retrieval.
QDRANT_URL=http://qdrant:6333

# OPTIONAL | used in: pipelines/rag_pipeline/config.py, pipelines/rag_pipeline/ingest.py
# Description: API key for secured Qdrant deployments.
QDRANT_API_KEY=

# OPTIONAL | used in: pipelines/rag_pipeline/config.py, pipelines/rag_pipeline/ingest.py
# Description: Qdrant collection that stores embedded medical knowledge chunks.
QDRANT_COLLECTION_NAME=medical_knowledge

# ===============================
# NOTIFICATIONS (SMTP / SENDGRID)
# ===============================

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/email_service.py
# Description: SMTP host used when sending notification email through SMTP.
SMTP_HOST=

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/email_service.py
# Description: SMTP port for outbound email delivery.
SMTP_PORT=587

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/email_service.py
# Description: SMTP username used to authenticate with the mail server.
SMTP_USERNAME=

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/email_service.py
# Description: SMTP password used to authenticate with the mail server.
SMTP_PASSWORD=

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/email_service.py
# Description: Sender email address for outbound notifications.
SMTP_FROM_EMAIL=

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/email_service.py
# Description: Enable STARTTLS for SMTP connections.
SMTP_USE_TLS=true

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/email_service.py
# Description: SendGrid API key used as the preferred email provider when present.
SENDGRID_API_KEY=

# ===============================
# NOTIFICATIONS (VAPID)
# ===============================

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/push_service.py
# Description: Public VAPID key paired with the private key for Web Push.
VAPID_PUBLIC_KEY=

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/push_service.py
# Description: Private VAPID key used to sign Web Push notifications.
VAPID_PRIVATE_KEY=

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/push_service.py
# Description: VAPID subject/contact claim.
VAPID_SUBJECT=mailto:notifications@example.com

# ===============================
# DEV / OPTIONAL
# ===============================

# OPTIONAL | used in: docker-compose.yml (pgadmin service)
# Description: Default login email for local pgAdmin.
PGADMIN_DEFAULT_EMAIL=admin@arogyaai.com

# OPTIONAL | used in: docker-compose.yml (pgadmin service)
# Description: Default login password for local pgAdmin.
PGADMIN_DEFAULT_PASSWORD=admin

# OPTIONAL | used in: docker-compose.yml, apps/backend/Dockerfile, pipelines/*/Dockerfile
# Description: HTTP proxy forwarded into Docker builds on restricted networks.
HTTP_PROXY=

# OPTIONAL | used in: docker-compose.yml, apps/backend/Dockerfile, pipelines/*/Dockerfile
# Description: HTTPS proxy forwarded into Docker builds on restricted networks.
HTTPS_PROXY=

# OPTIONAL | used in: docker-compose.yml, apps/backend/Dockerfile, pipelines/*/Dockerfile
# Description: Hosts that should bypass the configured HTTP/HTTPS proxy.
NO_PROXY=localhost,127.0.0.1,backend,postgres,redis,qdrant,prediction-service,rag-service

# OCR
OCR_GOOGLE_VISION_ENABLED=true
GOOGLE_APPLICATION_CREDENTIALS=
OCR_PDF_DPI=220
OCR_LOW_CONFIDENCE_THRESHOLD=0.55

# OPTIONAL | used in: docker-compose.yml, apps/backend/Dockerfile, pipelines/*/Dockerfile
# Description: Base64-encoded custom root CA certificate installed in Docker images.
CUSTOM_CA_CERT_B64=
