# PostgreSQL Database Credentials
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=arogyaai
DATABASE_URL=postgresql+psycopg2://user:password@postgres:5432/arogyaai

# pgAdmin 4 Access Defaults
PGADMIN_DEFAULT_EMAIL=admin@arogyaai.com
PGADMIN_DEFAULT_PASSWORD=admin

# Backend Config Defaults
ENVIRONMENT=development
JWT_SECRET_KEY=supersecretkey_change_in_production
APP_ENCRYPTION_KEY=
FRONTEND_APP_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
SUPABASE_URL=
SUPABASE_AUDIENCE=authenticated
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Fit Keys
GOOGLE_FIT_CLIENT_ID=GOOGLE_FIT_CLIENT_SECRET
GOOGLE_FIT_CLIENT_SECRET=GOOGLE_FIT_CLIENT_SECRET
GOOGLE_FIT_REDIRECT_URI=http://localhost:8000/api/v1/google-fit/oauth/callback
GOOGLE_FIT_DEFAULT_TIMEZONE=GOOGLE_FIT_DEFAULT_TIMEZONE
VITE_GOOGLE_FIT_DEFAULT_TIMEZONE=GOOGLE_FIT_DEFAULT_TIMEZONE

# API KEYS
OPENWEATHER_API_KEY= YOUR_API_KEY

# Optional: base64-encoded proxy/root CA certificate for Docker builds on filtered networks
# Example:
#   export CUSTOM_CA_CERT_B64="$(base64 < /path/to/your-root-ca.crt | tr -d '\n')"
CUSTOM_CA_CERT_B64=
