##################################################
# ╔══════════════════════════════════════════════╗
# ║       ArogyaAI Environment Template          ║
# ║                                              ║
# ║  SETUP:                                      ║
# ║    cp .env.template .env                     ║
# ║    # Fill values marked with "your_..."      ║
# ║    docker compose up --build                 ║
# ║                                              ║
# ║  VALUES marked [REQUIRED] must be set.       ║
# ║  VALUES marked [OPTIONAL] have safe defaults.║
# ╚══════════════════════════════════════════════╝
##################################################

##################################################
# CORE APPLICATION
##################################################
APP_ENV=development
FRONTEND_APP_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
VITE_API_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000

##################################################
# INTERNAL SERVICE URLS (Docker networking)
##################################################
PREDICTION_SERVICE_URL=http://prediction-service:8000
RAG_SERVICE_URL=http://rag-service:8000
WEARABLE_SERVICE_URL=http://wearable-service:8000

##################################################
# DATABASE (PostgreSQL + TimescaleDB)
##################################################
POSTGRES_USER=user
POSTGRES_PASSWORD=password
POSTGRES_DB=arogyaai
DATABASE_URL=postgresql+psycopg2://user:password@postgres:5432/arogyaai
DB_CONNECT_TIMEOUT_SECONDS=3
DATABASE_HOST_FALLBACK=127.0.0.1

##################################################
# REDIS / CELERY
##################################################
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/1

##################################################
# QDRANT (Vector DB)
##################################################
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
QDRANT_TIMEOUT_SECONDS=5.0
QDRANT_API_KEY=
QDRANT_COLLECTION_NAME=medical_knowledge

##################################################
# AUTH / SECURITY  [REQUIRED]
##################################################
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET_KEY=your_jwt_secret_key_here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
APP_ENCRYPTION_KEY=your_encryption_key_here

##################################################
# SUPABASE  [REQUIRED]
# Get keys from: Supabase Dashboard → Project Settings → API
##################################################
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET_NAME=reports
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_AUDIENCE=authenticated
# Frontend copies (Vite requires VITE_ prefix)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

##################################################
# GOOGLE FIT  [OPTIONAL — needed for wearable sync]
# Setup guide: docs/GOOGLE_FIT_SETUP.md
##################################################
GOOGLE_FIT_CLIENT_ID=your_google_fit_client_id_here
GOOGLE_FIT_CLIENT_SECRET=your_google_fit_client_secret_here
GOOGLE_FIT_REDIRECT_URI=http://localhost:8000/api/v1/google-fit/oauth/callback
GOOGLE_FIT_DEFAULT_TIMEZONE=Asia/Kolkata
VITE_GOOGLE_FIT_DEFAULT_TIMEZONE=Asia/Kolkata
GOOGLE_FIT_CA_BUNDLE=
GOOGLE_FIT_SSL_VERIFY=true

##################################################
# AI / ML CONFIGURATION  [OPTIONAL]
##################################################
ML_ALLOW_LEGACY_MODEL_FALLBACK=false

# Ollama (local LLM — must be running on host)
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=llama3.1:8b

# LoRA fine-tuning
LLM_LORA_ENABLED=false
LLM_LORA_ADAPTER_PATH=models/lora_adapter
OLLAMA_LORA_MODEL=

# OpenAI (fallback LLM provider)
OPENAI_API_KEY=your_openai_api_key_here

##################################################
# RAG CONFIGURATION  [OPTIONAL — advanced tuning]
##################################################
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_EMBEDDING_DIMENSIONS=384
RAG_CORPUS_DIR=data/medical_corpus
RAG_TOP_K=3
RAG_DENSE_TOP_K=10
RAG_SPARSE_TOP_K=10
RAG_RERANK_CANDIDATE_K=10
RAG_DENSE_WEIGHT=0.58
RAG_SPARSE_WEIGHT=0.42
RAG_RECREATE_ON_DIMENSION_MISMATCH=true
RAG_INDEX_VERSION=hybrid-bge-small-v1
RAG_TOP_FEATURE_COUNT=3
RAG_CHUNK_MIN_WORDS=300
RAG_CHUNK_MAX_WORDS=500
RAG_LLAMA_INDEX_ENABLED=true
RAG_LLAMA_INDEX_CHUNK_SIZE=512
RAG_LLAMA_INDEX_CHUNK_OVERLAP=80
RAG_LLM_API_BASE=
RAG_LLM_API_KEY=your_rag_llm_api_key_here
RAG_LLM_MODEL=gpt-4o-mini
RAG_LLM_TIMEOUT_SECONDS=8

##################################################
# EXTERNAL APIs  [OPTIONAL]
##################################################
OPENWEATHER_API_KEY=your_openweather_api_key_here
OCR_GOOGLE_VISION_ENABLED=true
GOOGLE_APPLICATION_CREDENTIALS=apps/backend/credentials/google-vision.json
OCR_PDF_DPI=220
OCR_LOW_CONFIDENCE_THRESHOLD=0.55

##################################################
# NOTIFICATIONS — SMTP  [OPTIONAL]
##################################################
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM_EMAIL=your_smtp_from_email_here
SMTP_USE_TLS=true
SENDGRID_API_KEY=your_sendgrid_api_key_here

##################################################
# NOTIFICATIONS — VAPID (Web Push)  [OPTIONAL]
# Generate with: npx web-push generate-vapid-keys
##################################################
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:notifications@example.com
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here

##################################################
# DEV / MISC
##################################################
DEBUG=true
PGADMIN_DEFAULT_EMAIL=admin@arogyaai.com
PGADMIN_DEFAULT_PASSWORD=admin
HTTP_PROXY=
HTTPS_PROXY=
NO_PROXY=localhost,127.0.0.1,backend,postgres,redis,qdrant,prediction-service,rag-service,wearable-service
CUSTOM_CA_CERT_B64=
AROGYAAI_CONTAINER=false
RUN_MIGRATIONS=true
DB_WAIT_RETRIES=30
DB_WAIT_SLEEP_SECONDS=2
REPORT_UPLOAD_DIR=uploads/reports
EMERGENCY_CHECK_INTERVAL_SECONDS=60
EMERGENCY_ALERT_RATE_LIMIT_MINUTES=15
CHAT_TRAINING_LOG_ENABLED=true
CHAT_TRAINING_LOG_MAX_ENTRIES=5000
CHAT_TRAINING_LOG_PATH=data/chat_training_logs.json
CHAT_LORA_DATASET_PATH=data/chat_lora_training.json
LORA_BASE_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
