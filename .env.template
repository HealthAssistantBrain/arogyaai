# HOW TO USE:
# 1. Copy this file to `.env` in the repository root.
# 2. Fill any REQUIRED values used by Docker Compose and shared pipeline services.
# 3. If you run the backend or frontend directly outside Docker, also copy:
#    - `apps/backend/.env.template` -> `apps/backend/.env`
#    - `apps/frontend/.env.template` -> `apps/frontend/.env`
# 4. Restart services after changing environment variables.
#
# OWNERSHIP:
# - Root `.env` is loaded by Docker Compose and shared sidecar services.
# - `apps/backend/.env` is loaded by FastAPI and the Celery worker.
# - `apps/frontend/.env` is loaded by local Vite development.
#
# NOTE:
# Some safe public `VITE_*` values appear here and in `apps/frontend/.env.template`.
# That duplication is intentional:
# - root `.env` supports Docker Compose
# - frontend `.env` supports local Vite

# ===============================
# DATABASE CONFIG
# ===============================

# OPTIONAL | used in: docker-compose.yml (postgres service)
# Description: PostgreSQL username for the local Docker database.
POSTGRES_USER=user

# OPTIONAL | used in: docker-compose.yml (postgres service)
# Description: PostgreSQL password for the local Docker database.
POSTGRES_PASSWORD=password

# OPTIONAL | used in: docker-compose.yml (postgres service)
# Description: PostgreSQL database name created for local development.
POSTGRES_DB=arogyaai

# ===============================
# CORE APP CONFIG
# ===============================

# Shared backend runtime settings do not belong here.
# See `apps/backend/.env.template` for app-level backend configuration.

# ===============================
# AUTH / SECURITY
# ===============================

# Backend auth and encryption secrets do not belong here.
# See `apps/backend/.env.template`.

# ===============================
# SUPABASE CONFIG
# ===============================

# OPTIONAL | used in: docker-compose.yml (frontend service), apps/frontend/src/lib/supabaseClient.js
# Description: Public Supabase project URL exposed to the frontend when running in Docker.
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# OPTIONAL | used in: docker-compose.yml (frontend service), apps/frontend/src/lib/supabaseClient.js, apps/backend/core/config.py
# Description: Public Supabase anon key exposed to the frontend in Docker; the backend also accepts it as a legacy fallback for OAuth token verification.
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ===============================
# GOOGLE FIT CONFIG
# ===============================

# Google Fit client secrets and redirect settings do not belong here.
# See `apps/backend/.env.template` and `apps/frontend/.env.template`.

# ===============================
# EXTERNAL APIs
# ===============================

# External API keys for backend integrations do not belong here.
# See `apps/backend/.env.template`.

# ===============================
# NOTIFICATION SYSTEM
# ===============================

# Email delivery credentials do not belong here.
# See `apps/backend/.env.template`.

# ===============================
# PUSH NOTIFICATIONS (VAPID)
# ===============================

# OPTIONAL | used in: apps/frontend/src/services/pushSubscriptionService.js
# Description: Public VAPID key exposed to the browser when the frontend runs in Docker.
VITE_VAPID_PUBLIC_KEY=

# ===============================
# RAG SYSTEM (QDRANT + LLM)
# ===============================

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Base URL for the Qdrant vector database used by the RAG service.
QDRANT_URL=http://qdrant:6333

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: API key for secured Qdrant deployments.
QDRANT_API_KEY=

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Qdrant collection that stores embedded medical knowledge chunks.
QDRANT_COLLECTION_NAME=medical_knowledge

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Embedding model used to vectorize the medical corpus.
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Embedding dimension expected by the configured embedding model.
RAG_EMBEDDING_DIMENSIONS=384

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Local path to the source corpus used for RAG indexing.
RAG_CORPUS_DIR=data/medical_corpus

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Number of top-matching chunks retrieved for each RAG answer.
RAG_TOP_K=4

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Number of top contributing features included in generated explanations.
RAG_TOP_FEATURE_COUNT=3

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Minimum words allowed in each indexed corpus chunk.
RAG_CHUNK_MIN_WORDS=300

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Maximum words allowed in each indexed corpus chunk.
RAG_CHUNK_MAX_WORDS=500

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Ollama base URL used when the RAG service runs against a local Ollama model.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Ollama model name used for local RAG completions.
OLLAMA_MODEL=llama3.1:8b

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: OpenAI-compatible base URL used for hosted RAG completions instead of Ollama.
RAG_LLM_API_BASE=

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: API key for the hosted RAG LLM endpoint; falls back to OPENAI_API_KEY when blank.
RAG_LLM_API_KEY=

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Fallback API key used when the hosted RAG provider expects a generic OpenAI-style key.
OPENAI_API_KEY=

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Hosted LLM model name used for RAG completions.
RAG_LLM_MODEL=gpt-4o-mini

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Timeout in seconds for RAG LLM requests.
RAG_LLM_TIMEOUT_SECONDS=8

# ===============================
# OPTIONAL / DEV ONLY
# ===============================

# OPTIONAL | used in: docker-compose.yml (pgadmin service)
# Description: Default email for the local pgAdmin instance.
PGADMIN_DEFAULT_EMAIL=admin@arogyaai.com

# OPTIONAL | used in: docker-compose.yml (pgadmin service)
# Description: Default password for the local pgAdmin instance.
PGADMIN_DEFAULT_PASSWORD=admin

# OPTIONAL | used in: docker-compose.yml, apps/backend/Dockerfile, pipelines/*/Dockerfile
# Description: HTTP proxy forwarded into Docker builds on restricted networks.
HTTP_PROXY=

# OPTIONAL | used in: docker-compose.yml, apps/backend/Dockerfile, pipelines/*/Dockerfile
# Description: HTTPS proxy forwarded into Docker builds on restricted networks.
HTTPS_PROXY=

# OPTIONAL | used in: docker-compose.yml, apps/backend/Dockerfile, pipelines/*/Dockerfile
# Description: Hosts that should bypass the configured HTTP/HTTPS proxy during Docker builds.
NO_PROXY=localhost,127.0.0.1,backend,postgres,redis,qdrant,prediction-service,rag-service,wearable-service

# OPTIONAL | used in: docker-compose.yml, apps/backend/Dockerfile, pipelines/*/Dockerfile
# Description: Base64-encoded custom root CA certificate installed in Docker images for filtered networks.
CUSTOM_CA_CERT_B64=

# OPTIONAL | used in: pipelines/ml_pipeline/model_loader.py, apps/backend/services/risk_engine.py
# Description: Path to a trained AI insights model artifact.
AI_INSIGHTS_MODEL_PATH=

# OPTIONAL | used in: pipelines/ml_pipeline/model_loader.py
# Description: Legacy alias for AI_INSIGHTS_MODEL_PATH retained for compatibility.
ML_MODEL_PATH=
