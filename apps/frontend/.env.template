##################################################
# ArogyaAI Frontend Environment
#
# Copy to .env:  cp .env.template .env
# Then fill values marked with "your_..."
#
# NOTE: All frontend env vars MUST start with VITE_
# to be accessible in the browser bundle.
##################################################

##################################################
# API CONNECTION
##################################################
VITE_API_URL=http://127.0.0.1:8000
VITE_API_BASE_URL=http://127.0.0.1:8000

##################################################
# SUPABASE  [REQUIRED]
##################################################
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here

##################################################
# GOOGLE FIT  [OPTIONAL]
##################################################
VITE_GOOGLE_FIT_DEFAULT_TIMEZONE=Asia/Kolkata

##################################################
# NOTIFICATIONS (VAPID)  [OPTIONAL]
##################################################
VITE_VAPID_PUBLIC_KEY=your_vapid_public_key_here
