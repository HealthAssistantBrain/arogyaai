# HOW TO USE:
# 1. Copy this file to `apps/frontend/.env`.
# 2. Fill REQUIRED fields.
# 3. Restart services.
#
# SCOPE:
# Frontend `.env` is read by Vite for local frontend development.
# Only browser-safe `VITE_*` variables belong here.
#
# NOTE:
# Docker Compose also reads this file for the frontend container. Restart the
# frontend service after changing VITE_* values.

# ===============================
# FRONTEND CONFIG
# ===============================

# REQUIRED | used in: apps/frontend/src/lib/axios.js, apps/frontend/src/lib/apiClient.ts, apps/frontend/src/lib/authSync.ts, apps/frontend/src/store/authStore.js, apps/frontend/src/pages/Dashboard.jsx, apps/frontend/src/pages/Timeline.jsx
# Description: Preferred public base URL for the backend API. `/api/v1` is appended by the frontend helpers.
VITE_API_URL=http://127.0.0.1:8000

# OPTIONAL | used in: apps/frontend/src/lib/axios.js, apps/frontend/src/lib/apiClient.ts, apps/frontend/src/lib/authSync.ts, apps/frontend/src/store/authStore.js, apps/frontend/src/pages/Dashboard.jsx, apps/frontend/src/pages/Timeline.jsx
# Description: Legacy alias for VITE_API_URL retained for compatibility with existing modules.
VITE_API_BASE_URL=http://127.0.0.1:8000

# ===============================
# SUPABASE
# ===============================

# REQUIRED | used in: apps/frontend/src/lib/supabaseClient.js, apps/frontend/src/main.jsx
# Description: Public Supabase project URL used by the browser for authentication.
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# REQUIRED | used in: apps/frontend/src/lib/supabaseClient.js, apps/frontend/src/main.jsx
# Description: Public Supabase anon key used by the browser for authentication.
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ===============================
# GOOGLE FIT
# ===============================

# OPTIONAL | used in: apps/frontend/src/pages/GoogleFitSettings.jsx
# Description: Default timezone shown in Google Fit settings.
VITE_GOOGLE_FIT_DEFAULT_TIMEZONE=Asia/Kolkata

# ===============================
# NOTIFICATIONS (VAPID)
# ===============================

# OPTIONAL | used in: apps/frontend/src/services/pushSubscriptionService.js
# Description: Public VAPID key used by the browser to create Web Push subscriptions.
VITE_VAPID_PUBLIC_KEY=

# ===============================
# DEV / OPTIONAL
# ===============================

# OPTIONAL | used in: apps/frontend/src/pages/Dashboard.jsx
# Description: `import.meta.env.DEV` is built into Vite and must not be defined here.
