##################################################
# ArogyaAI Backend Environment
#
# NOTE: In Docker mode, the root .env is used.
# This file is for local (non-Docker) development only.
#
# Copy to .env:  cp .env.template .env
##################################################

##################################################
# CORE SYSTEM
##################################################
FRONTEND_APP_URL=http://localhost:5173
BACKEND_PUBLIC_URL=http://localhost:8000
PREDICTION_SERVICE_URL=http://prediction-service:8000
RAG_SERVICE_URL=http://rag-service:8000
WEARABLE_SERVICE_URL=http://wearable-service:8000

##################################################
# DATABASE
##################################################
DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/arogyaai
DB_CONNECT_TIMEOUT_SECONDS=3
DATABASE_HOST_FALLBACK=127.0.0.1

##################################################
# ANALYTICS DATABASE (NEON + TIMESCALEDB)
##################################################
ANALYTICS_DB_MODE=primary
NEON_DATABASE_URL=
NEON_DIRECT_URL=
TIMESCALE_ENABLED=true
ANALYTICS_DB_READ_FALLBACK=true
RUN_ANALYTICS_MIGRATIONS=false
ANALYTICS_WAIT_RETRIES=15
ANALYTICS_WAIT_SLEEP_SECONDS=2
HEALTH_PRIMARY_DB_TIMEOUT_SECONDS=4
HEALTH_ANALYTICS_DB_TIMEOUT_SECONDS=12
HEALTH_TIMESCALE_TIMEOUT_SECONDS=12
HEALTH_OPTIONAL_PROBE_BUDGET_SECONDS=2.5

##################################################
# REDIS / CELERY
##################################################
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

##################################################
# AUTH / SECURITY  [REQUIRED]
##################################################
JWT_SECRET_KEY=your_jwt_secret_key_here
# Legacy backend JWT algorithm retained only for deprecated code paths.
# Active auth verification now uses Supabase JWKS / issuer / audience checks.
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
APP_ENCRYPTION_KEY=your_encryption_key_here

##################################################
# SUPABASE  [REQUIRED]
##################################################
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_BUCKET_NAME=reports
SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_AUDIENCE=authenticated
SUPABASE_JWT_ISSUER=https://your-project-id.supabase.co/auth/v1
SUPABASE_STORAGE_SIGNED_URL_TTL_SECONDS=900
SUPABASE_JWKS_CACHE_TTL_SECONDS=600
SUPABASE_JWKS_STALE_TTL_SECONDS=86400
SUPABASE_JWKS_FETCH_TIMEOUT_SECONDS=3.0
SUPABASE_JWKS_FETCH_RETRIES=2
SUPABASE_JWKS_RETRY_BACKOFF_SECONDS=0.75
SUPABASE_JWKS_REFRESH_COOLDOWN_SECONDS=30.0
SUPABASE_JWKS_FAILURE_COOLDOWN_SECONDS=15.0
SUPABASE_JWKS_STARTUP_WARMUP=true
SUPABASE_AUTH_STARTUP_TIMEOUT_SECONDS=5.0

##################################################
# GOOGLE FIT  [OPTIONAL]
##################################################
GOOGLE_FIT_CLIENT_ID=your_google_fit_client_id_here
GOOGLE_FIT_CLIENT_SECRET=your_google_fit_client_secret_here
GOOGLE_FIT_REDIRECT_URI=http://localhost:8000/api/v1/google-fit/oauth/callback
GOOGLE_FIT_DEFAULT_TIMEZONE=Asia/Kolkata
GOOGLE_FIT_CA_BUNDLE=
GOOGLE_FIT_SSL_VERIFY=true

##################################################
# ML / RAG CONFIG
##################################################
ML_ALLOW_LEGACY_MODEL_FALLBACK=false
QDRANT_MODE=local
QDRANT_URL=
LOCAL_QDRANT_URL=http://localhost:6333
QDRANT_TIMEOUT_SECONDS=5.0
QDRANT_API_KEY=
QDRANT_COLLECTION_MEDICAL=medical_knowledge
QDRANT_DISTANCE_METRIC=cosine
QDRANT_REQUEST_RETRIES=2
QDRANT_RETRY_BACKOFF_SECONDS=0.75
QDRANT_UNHEALTHY_COOLDOWN_SECONDS=20
QDRANT_UPSERT_BATCH_SIZE=128
QDRANT_LOCAL_FALLBACK_ENABLED=true

RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
RAG_EMBEDDING_DIMENSIONS=384
RAG_CORPUS_DIR=data/medical_corpus
RAG_TOP_K=3

##################################################
# LLM / OLLAMA
##################################################
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
OLLAMA_TIMEOUT_SECONDS=75
OLLAMA_CONNECT_TIMEOUT_SECONDS=5
OLLAMA_KEEP_ALIVE=30m
OLLAMA_REQUEST_RETRIES=1
OLLAMA_RETRY_BACKOFF_SECONDS=1.0
OLLAMA_WARMUP_ON_STARTUP=true
OLLAMA_HEALTH_WARMUP_ENABLED=false
LLM_LORA_ENABLED=false
OPENAI_API_KEY=your_openai_api_key_here
RAG_LLM_API_BASE=
RAG_LLM_API_KEY=
RAG_LLM_MODEL=gpt-4o-mini
RAG_LLM_TIMEOUT_SECONDS=20
AI_PROVIDER_PRIMARY=nvidia
AI_PROVIDER_FALLBACK_CHAIN=nvidia,ollama,openai
AI_PROVIDER_DEFAULT_TIMEOUT_SECONDS=12
AI_PROVIDER_HEALTH_COOLDOWN_SECONDS=45
AI_PROVIDER_HEALTH_MAX_CONSECUTIVE_FAILURES=3
AI_PROVIDER_LATENCY_BUDGET_MS=8000
AI_PROVIDER_CACHE_TTL_SECONDS=600
AI_PROVIDER_DEMO_MODE=false
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_TIMEOUT_SECONDS=18
NVIDIA_REQUEST_RETRIES=1
NVIDIA_RETRY_BACKOFF_SECONDS=1.2
NVIDIA_DEFAULT_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_FAST_MODEL=meta/llama-3.1-8b-instruct
NVIDIA_REASONING_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_SUMMARY_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_CHAT_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_OCR_ANALYSIS_MODEL=meta/llama-3.1-70b-instruct
NVIDIA_STRUCTURED_JSON_MODEL=meta/llama-3.1-70b-instruct

##################################################
# EXTERNAL APIs  [OPTIONAL]
##################################################
OPENWEATHER_API_KEY=your_openweather_api_key_here
OCR_GOOGLE_VISION_ENABLED=true
GOOGLE_APPLICATION_CREDENTIALS=credentials/google-vision.json

##################################################
# NOTIFICATIONS (SMTP)  [OPTIONAL]
##################################################
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_smtp_username_here
SMTP_PASSWORD=your_smtp_password_here
SMTP_FROM_EMAIL=your_smtp_from_email_here
SMTP_USE_TLS=true
SENDGRID_API_KEY=

##################################################
# NOTIFICATIONS (VAPID)  [OPTIONAL]
##################################################
VAPID_PUBLIC_KEY=your_vapid_public_key_here
VAPID_PRIVATE_KEY=your_vapid_private_key_here
VAPID_SUBJECT=mailto:notifications@example.com

##################################################
# DEV / MISC
##################################################
AROGYAAI_CONTAINER=false
RUN_MIGRATIONS=true
DB_WAIT_RETRIES=30
DB_WAIT_SLEEP_SECONDS=2
# Deprecated: local report storage is no longer used for new uploads.
REPORT_UPLOAD_DIR=uploads/reports
