# HOW TO USE:
# 1. Copy this file to `apps/backend/.env`.
# 2. Fill all REQUIRED values before starting the FastAPI backend or Celery worker.
# 3. Keep secrets in this file only.
# 4. Restart backend services after changing environment variables.
#
# SCOPE:
# This file is the canonical home for backend-only settings:
# database access, JWT/auth, Supabase server credentials, Google Fit, email, push, and backend service URLs.

# ===============================
# DATABASE CONFIG
# ===============================

# REQUIRED | used in: apps/backend/database/session.py, apps/backend/alembic/env.py, apps/backend/docker/backend-entrypoint.sh
# Description: SQLAlchemy/PostgreSQL connection string for the backend database.
DATABASE_URL=postgresql+psycopg2://user:password@postgres:5432/arogyaai

# OPTIONAL | used in: apps/backend/database/session.py, apps/backend/services/dashboard_realtime.py, apps/backend/docker/backend-entrypoint.sh
# Description: PostgreSQL connection timeout in seconds for startup and readiness checks.
DB_CONNECT_TIMEOUT_SECONDS=3

# OPTIONAL | used in: apps/backend/services/health_service.py
# Description: Redis URL used by the backend readiness probe.
REDIS_URL=redis://redis:6379/0

# OPTIONAL | used in: apps/backend/core/celery_app.py
# Description: Redis broker URL used by Celery task dispatch.
CELERY_BROKER_URL=redis://redis:6379/0

# OPTIONAL | used in: apps/backend/core/celery_app.py
# Description: Redis backend URL used by Celery task result storage.
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ===============================
# CORE APP CONFIG
# ===============================

# REQUIRED | used in: apps/backend/main.py, apps/backend/routes/google_fit.py, apps/backend/services/google_fit_service.py, apps/backend/core/session_cookies.py
# Description: Public frontend URL used for CORS, redirects, and cookie security decisions.
FRONTEND_APP_URL=http://localhost:5173

# REQUIRED | used in: apps/backend/core/config.py, apps/backend/services/google_fit_service.py, apps/backend/core/session_cookies.py
# Description: Public backend base URL used for generated callback URLs and secure-cookie detection.
BACKEND_PUBLIC_URL=http://localhost:8000

# OPTIONAL | used in: apps/backend/integrations/prediction_client.py, apps/backend/services/health_service.py
# Description: Internal base URL for the prediction microservice.
PREDICTION_SERVICE_URL=http://prediction-service:8000

# OPTIONAL | used in: apps/backend/integrations/rag_client.py, apps/backend/services/health_service.py
# Description: Internal base URL for the RAG microservice.
RAG_SERVICE_URL=http://rag-service:8000

# OPTIONAL | used in: apps/backend/integrations/wearable_client.py, apps/backend/services/health_service.py
# Description: Internal base URL for the wearable ingestion microservice.
WEARABLE_SERVICE_URL=http://wearable-service:8000

# ===============================
# AUTH / SECURITY
# ===============================

# REQUIRED | used in: apps/backend/core/config.py, apps/backend/core/security.py
# Description: Secret key used for JWT signing.
JWT_SECRET_KEY=change_me

# REQUIRED | used in: apps/backend/core/config.py, apps/backend/core/security.py
# Description: Application encryption key used for sensitive stored values.
APP_ENCRYPTION_KEY=change_me

# ===============================
# SUPABASE CONFIG
# ===============================

# REQUIRED | used in: apps/backend/core/config.py, apps/backend/integrations/supabase_storage.py, apps/backend/services/auth_service.py
# Description: Supabase project URL used for storage access and OAuth token validation.
SUPABASE_URL=https://your-project-id.supabase.co

# REQUIRED | used in: apps/backend/core/config.py, apps/backend/integrations/supabase_storage.py, apps/backend/main.py
# Description: Supabase service-role key used by the backend to upload medical reports and bypass RLS when needed.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# REQUIRED | used in: apps/backend/core/config.py, apps/backend/integrations/supabase_storage.py
# Description: Supabase Storage bucket name used for uploaded medical reports.
SUPABASE_BUCKET_NAME=reports

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/auth_service.py
# Description: Expected Supabase JWT audience for OAuth token verification.
SUPABASE_AUDIENCE=authenticated

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/auth_service.py
# Description: Public Supabase anon key used by the backend during Supabase OAuth token verification.
SUPABASE_ANON_KEY=

# ===============================
# GOOGLE FIT CONFIG
# ===============================

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/google_fit_service.py
# Description: Google OAuth client ID for Google Fit integration.
GOOGLE_FIT_CLIENT_ID=

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/google_fit_service.py
# Description: Google OAuth client secret for Google Fit integration.
GOOGLE_FIT_CLIENT_SECRET=

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/google_fit_service.py
# Description: Explicit Google Fit OAuth callback URL; leave blank to derive it from BACKEND_PUBLIC_URL.
GOOGLE_FIT_REDIRECT_URI=http://localhost:8000/api/v1/google-fit/oauth/callback

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/google_fit_service.py, apps/backend/services/sleep_service.py
# Description: Default IANA timezone used when sync requests do not provide one.
GOOGLE_FIT_DEFAULT_TIMEZONE=Asia/Kolkata

# ===============================
# EXTERNAL APIs
# ===============================

# OPTIONAL | used in: apps/backend/services/aqi_service.py
# Description: OpenWeather API key used for AQI current conditions, history, and location lookup.
OPENWEATHER_API_KEY=

# ===============================
# NOTIFICATION SYSTEM
# ===============================

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/email_service.py
# Description: SMTP host used when sending email through SMTP instead of SendGrid.
SMTP_HOST=

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/email_service.py
# Description: SMTP port used for outbound email delivery.
SMTP_PORT=587

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/email_service.py
# Description: SMTP username used to authenticate with the mail server.
SMTP_USERNAME=

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/email_service.py
# Description: SMTP password used to authenticate with the mail server.
SMTP_PASSWORD=

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/email_service.py
# Description: Sender email address for outbound notifications.
SMTP_FROM_EMAIL=

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/email_service.py
# Description: Set to true to enable STARTTLS for SMTP.
SMTP_USE_TLS=true

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/email_service.py
# Description: SendGrid API key used as the preferred email provider when present.
SENDGRID_API_KEY=

# ===============================
# PUSH NOTIFICATIONS (VAPID)
# ===============================

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/push_service.py
# Description: Public VAPID key paired with the private key for Web Push subscriptions.
VAPID_PUBLIC_KEY=

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/push_service.py
# Description: Private VAPID key used to sign Web Push notifications.
VAPID_PRIVATE_KEY=

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/push_service.py
# Description: Contact subject included in VAPID claims.
VAPID_SUBJECT=mailto:notifications@example.com

# ===============================
# RAG SYSTEM (QDRANT + LLM)
# ===============================

# Backend RAG engine settings live in the root `.env.template`
# because the shared RAG service reads them from the root Docker environment.

# ===============================
# OPTIONAL / DEV ONLY
# ===============================

# OPTIONAL | used in: apps/backend/docker/backend-entrypoint.sh
# Description: Controls whether Alembic migrations run automatically on container startup.
RUN_MIGRATIONS=true

# OPTIONAL | used in: apps/backend/docker/backend-entrypoint.sh
# Description: Number of attempts to wait for PostgreSQL before startup fails.
DB_WAIT_RETRIES=30

# OPTIONAL | used in: apps/backend/docker/backend-entrypoint.sh
# Description: Seconds to wait between PostgreSQL readiness checks.
DB_WAIT_SLEEP_SECONDS=2

# OPTIONAL | used in: apps/backend/core/config.py
# Description: Deprecated local upload directory fallback; Supabase Storage is the supported path.
REPORT_UPLOAD_DIR=uploads/reports

# OPTIONAL | used in: apps/backend/services/risk_engine.py
# Description: Path to a trained AI insights model artifact.
AI_INSIGHTS_MODEL_PATH=
