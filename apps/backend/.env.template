# HOW TO USE:
# 1. Copy this file to `apps/backend/.env`.
# 2. Fill REQUIRED fields.
# 3. Restart services.
#
# SCOPE:
# Backend `.env` is read by FastAPI, Celery workers, Alembic, backend services,
# ML pipelines, RAG pipelines, notifications, and local backend tests.
#
# SECURITY:
# Keep secrets server-side. Do not put `VITE_*` browser variables in this file.

# ===============================
# CORE SYSTEM
# ===============================

# REQUIRED | used in: apps/backend/main.py, apps/backend/routes/google_fit.py, apps/backend/services/google_fit_service.py, apps/backend/core/session_cookies.py
# Description: Public frontend URL used for CORS, redirects, and secure-cookie decisions.
FRONTEND_APP_URL=http://localhost:5173

# REQUIRED | used in: apps/backend/core/config.py, apps/backend/services/google_fit_service.py, apps/backend/core/session_cookies.py
# Description: Public backend URL used for generated callback URLs and cookie security checks.
BACKEND_PUBLIC_URL=http://localhost:8000

# OPTIONAL | used in: apps/backend/integrations/prediction_client.py, apps/backend/services/health_service.py
# Description: Internal base URL for the prediction microservice.
PREDICTION_SERVICE_URL=http://prediction-service:8000

# OPTIONAL | used in: apps/backend/integrations/rag_client.py, apps/backend/services/health_service.py
# Description: Internal base URL for the RAG microservice.
RAG_SERVICE_URL=http://rag-service:8000

# OPTIONAL | used in: apps/backend/integrations/ocr_service.py
# Description: Enables Google Vision as the primary OCR provider when GOOGLE_APPLICATION_CREDENTIALS is configured.
OCR_GOOGLE_VISION_ENABLED=true

# OPTIONAL | used in: apps/backend/integrations/ocr_service.py
# Description: Path to Google service-account credentials JSON mounted inside the backend container.
GOOGLE_APPLICATION_CREDENTIALS=

# OPTIONAL | used in: apps/backend/integrations/ocr_service.py
# Description: DPI used when rendering scanned PDFs for local Tesseract OCR fallback.
OCR_PDF_DPI=220

# OPTIONAL | used in: apps/backend/integrations/ocr_service.py
# Description: Google Vision confidence threshold below which Tesseract fallback is attempted.
OCR_LOW_CONFIDENCE_THRESHOLD=0.55

# OPTIONAL | used in: apps/backend/services/health_service.py
# Description: Redis URL used by backend readiness probes.
REDIS_URL=redis://redis:6379/0

# OPTIONAL | used in: apps/backend/core/celery_app.py
# Description: Redis broker URL used by Celery task dispatch.
CELERY_BROKER_URL=redis://redis:6379/0

# OPTIONAL | used in: apps/backend/core/celery_app.py
# Description: Redis backend URL used by Celery task result storage.
CELERY_RESULT_BACKEND=redis://redis:6379/1

# ===============================
# DATABASE
# ===============================

# REQUIRED | used in: apps/backend/database/session.py, apps/backend/alembic/env.py, apps/backend/docker/backend-entrypoint.sh, pipelines/ml_pipeline/data_loader.py
# Description: SQLAlchemy/PostgreSQL connection string for the backend database.
DATABASE_URL=postgresql+psycopg2://user:password@postgres:5432/arogyaai

# OPTIONAL | used in: apps/backend/database/session.py, apps/backend/services/dashboard_realtime.py, apps/backend/docker/backend-entrypoint.sh
# Description: PostgreSQL connection timeout in seconds.
DB_CONNECT_TIMEOUT_SECONDS=3

# OPTIONAL | used in: pipelines/ml_pipeline/data_loader.py
# Description: Host override for local ML training when DATABASE_URL points to Docker host `postgres`.
DATABASE_HOST_FALLBACK=127.0.0.1

# ===============================
# AUTH / SECURITY
# ===============================

# REQUIRED | used in: apps/backend/core/config.py, apps/backend/core/security.py, apps/backend/services/google_fit_service.py
# Description: Canonical JWT signing secret. Use a long random value in production.
JWT_SECRET_KEY=change_me_use_a_long_random_value

# OPTIONAL | used in: apps/backend/core/security.py
# Description: JWT algorithm used for access, refresh, and Google Fit state tokens.
ALGORITHM=HS256

# OPTIONAL | used in: apps/backend/core/security.py, apps/backend/core/session_cookies.py
# Description: Access token lifetime in minutes.
ACCESS_TOKEN_EXPIRE_MINUTES=15

# OPTIONAL | used in: apps/backend/core/security.py, apps/backend/core/session_cookies.py
# Description: Refresh token lifetime in days.
REFRESH_TOKEN_EXPIRE_DAYS=30

# REQUIRED | used in: apps/backend/core/config.py, apps/backend/core/security.py
# Description: Encryption key for sensitive stored values. Use a long random value in production.
APP_ENCRYPTION_KEY=change_me_use_a_long_random_value

# ===============================
# SUPABASE
# ===============================

# REQUIRED | used in: apps/backend/core/config.py, apps/backend/integrations/supabase_storage.py, apps/backend/services/auth_service.py
# Description: Supabase project URL used for storage and OAuth token validation.
SUPABASE_URL=https://your-project-id.supabase.co

# REQUIRED | used in: apps/backend/core/config.py, apps/backend/integrations/supabase_storage.py, apps/backend/main.py
# Description: Supabase service-role key used by the backend for trusted storage operations.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# REQUIRED | used in: apps/backend/core/config.py, apps/backend/integrations/supabase_storage.py
# Description: Supabase Storage bucket for uploaded medical reports.
SUPABASE_BUCKET_NAME=medical-reports

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/auth_service.py
# Description: Public Supabase anon key used by backend OAuth/JWKS validation.
SUPABASE_ANON_KEY=

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/auth_service.py
# Description: Expected Supabase JWT audience.
SUPABASE_AUDIENCE=authenticated

# ===============================
# GOOGLE FIT
# ===============================

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/google_fit_service.py
# Description: Google OAuth client ID for Google Fit integration.
GOOGLE_FIT_CLIENT_ID=

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/google_fit_service.py
# Description: Google OAuth client secret for Google Fit integration.
GOOGLE_FIT_CLIENT_SECRET=

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/google_fit_service.py
# Description: Explicit OAuth callback URL; leave blank to derive from BACKEND_PUBLIC_URL.
GOOGLE_FIT_REDIRECT_URI=

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/google_fit_service.py, apps/backend/services/sleep_service.py, apps/backend/services/user_data_service.py
# Description: Default IANA timezone used when sync requests do not provide one.
GOOGLE_FIT_DEFAULT_TIMEZONE=Asia/Kolkata

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/google_fit_service.py
# Description: Path to a PEM CA bundle for Google Fit HTTPS requests. Leave blank to use SSL_CERT_FILE/REQUESTS_CA_BUNDLE/certifi.
GOOGLE_FIT_CA_BUNDLE=

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/google_fit_service.py
# Description: Set false only for local development diagnostics; production should keep certificate verification enabled.
GOOGLE_FIT_SSL_VERIFY=true

# ===============================
# ML CONFIG
# ===============================

# OPTIONAL | used in: pipelines/ml_pipeline/model_loader.py, apps/backend/services/risk_engine.py
# Description: Path to a legacy/default trained diabetes AI insights model artifact.
AI_INSIGHTS_MODEL_PATH=

# OPTIONAL | used in: pipelines/ml_pipeline/model_loader.py
# Description: Legacy alias for AI_INSIGHTS_MODEL_PATH.
ML_MODEL_PATH=

# OPTIONAL | used in: pipelines/ml_pipeline/model_loader.py
# Description: Preferred path to the diabetes model artifact.
ML_DIABETES_MODEL_PATH=

# OPTIONAL | used in: pipelines/ml_pipeline/model_loader.py
# Description: Legacy diabetes model path alias.
DIABETES_MODEL_PATH=

# OPTIONAL | used in: pipelines/ml_pipeline/model_loader.py
# Description: Preferred path to the cardiovascular model artifact.
ML_CARDIO_MODEL_PATH=

# OPTIONAL | used in: pipelines/ml_pipeline/model_loader.py
# Description: Legacy cardiovascular model path alias.
ML_CARDIOVASCULAR_MODEL_PATH=

# OPTIONAL | used in: pipelines/ml_pipeline/model_loader.py
# Description: Legacy cardiovascular model path alias.
CARDIO_MODEL_PATH=

# OPTIONAL | used in: pipelines/ml_pipeline/model_loader.py
# Description: Preferred path to the sleep model artifact.
ML_SLEEP_MODEL_PATH=

# OPTIONAL | used in: pipelines/ml_pipeline/model_loader.py
# Description: Legacy sleep model path alias.
SLEEP_MODEL_PATH=

# OPTIONAL | used in: pipelines/ml_pipeline/model_loader.py
# Description: Allow fallback to legacy model files under `apps/backend/models`.
ML_ALLOW_LEGACY_MODEL_FALLBACK=false

# ===============================
# RAG CONFIG
# ===============================

# OPTIONAL | used in: pipelines/rag_pipeline/config.py, pipelines/rag_pipeline/ingest.py
# Description: Qdrant vector database base URL for RAG indexing and retrieval.
QDRANT_HOST=qdrant
QDRANT_PORT=6333
QDRANT_URL=http://qdrant:6333
QDRANT_TIMEOUT_SECONDS=5.0

# OPTIONAL | used in: pipelines/rag_pipeline/config.py, pipelines/rag_pipeline/ingest.py
# Description: API key for secured Qdrant deployments.
QDRANT_API_KEY=

# OPTIONAL | used in: pipelines/rag_pipeline/config.py, pipelines/rag_pipeline/ingest.py
# Description: Qdrant collection that stores embedded medical knowledge chunks.
QDRANT_COLLECTION_NAME=medical_knowledge

# OPTIONAL | used in: pipelines/rag_pipeline/config.py, pipelines/rag_pipeline/ingest.py
# Description: Embedding model used to vectorize the medical corpus.
RAG_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5

# OPTIONAL | used in: pipelines/rag_pipeline/config.py, pipelines/rag_pipeline/ingest.py
# Description: Embedding dimension expected by the configured embedding model.
RAG_EMBEDDING_DIMENSIONS=384

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Local path to the source corpus used for RAG indexing.
RAG_CORPUS_DIR=data/medical_corpus

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Final number of reranked chunks returned for each RAG answer.
RAG_TOP_K=3

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Number of dense Qdrant candidates fetched before hybrid reranking.
RAG_DENSE_TOP_K=10

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Number of sparse BM25 candidates fetched before hybrid reranking.
RAG_SPARSE_TOP_K=10

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Number of combined candidates reranked before final selection.
RAG_RERANK_CANDIDATE_K=10

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Relative weight for dense retrieval during hybrid ranking.
RAG_DENSE_WEIGHT=0.58

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Relative weight for sparse retrieval during hybrid ranking.
RAG_SPARSE_WEIGHT=0.42

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Recreate Qdrant index if embedding dimensions change.
RAG_RECREATE_ON_DIMENSION_MISMATCH=true

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: RAG index schema/version marker stored with indexed content.
RAG_INDEX_VERSION=hybrid-bge-small-v1

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Number of top contributing features included in explanations.
RAG_TOP_FEATURE_COUNT=3

# OPTIONAL | used in: pipelines/rag_pipeline/config.py, pipelines/rag_pipeline/ingest.py
# Description: Minimum words allowed in each indexed corpus chunk.
RAG_CHUNK_MIN_WORDS=300

# OPTIONAL | used in: pipelines/rag_pipeline/config.py, pipelines/rag_pipeline/ingest.py
# Description: Maximum words allowed in each indexed corpus chunk.
RAG_CHUNK_MAX_WORDS=500

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Enable the optional LlamaIndex retrieval layer before fallback retrieval.
RAG_LLAMA_INDEX_ENABLED=true

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Token chunk size used by LlamaIndex.
RAG_LLAMA_INDEX_CHUNK_SIZE=512

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Token overlap used by LlamaIndex.
RAG_LLAMA_INDEX_CHUNK_OVERLAP=80

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Ollama base URL for local RAG/LLM completions.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# OPTIONAL | used in: pipelines/rag_pipeline/config.py, pipelines/llm_pipeline/train_lora.py
# Description: Base Ollama model used for local RAG completions and LoRA Modelfile generation.
OLLAMA_MODEL=llama3.1:8b

# OPTIONAL | used in: pipelines/rag_pipeline/config.py, apps/backend/services/chat_service.py
# Description: Enable optional clinical LoRA adapter-backed Ollama model when adapter files exist.
LLM_LORA_ENABLED=false

# OPTIONAL | used in: pipelines/rag_pipeline/config.py, apps/backend/services/chat_service.py
# Description: Path where the PEFT LoRA adapter is saved and checked.
LLM_LORA_ADAPTER_PATH=models/lora_adapter

# OPTIONAL | used in: pipelines/rag_pipeline/config.py, apps/backend/services/chat_service.py
# Description: Ollama model created from the LoRA adapter.
OLLAMA_LORA_MODEL=

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: OpenAI-compatible hosted LLM base URL used instead of Ollama.
RAG_LLM_API_BASE=

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: API key for the hosted RAG LLM endpoint.
RAG_LLM_API_KEY=

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Fallback API key when the RAG provider expects a generic OpenAI-style key.
OPENAI_API_KEY=

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Hosted LLM model name used for RAG completions.
RAG_LLM_MODEL=gpt-4o-mini

# OPTIONAL | used in: pipelines/rag_pipeline/config.py
# Description: Timeout in seconds for RAG LLM requests.
RAG_LLM_TIMEOUT_SECONDS=8

# OPTIONAL | used in: pipelines/rag_pipeline/ingest.py
# Description: Force RAG ingestion to use container service DNS such as `qdrant`.
AROGYAAI_CONTAINER=false

# ===============================
# EXTERNAL APIs
# ===============================

# OPTIONAL | used in: apps/backend/services/aqi_service.py
# Description: OpenWeather API key used for AQI current conditions, history, and location lookup.
OPENWEATHER_API_KEY=

# ===============================
# NOTIFICATIONS (SMTP / SENDGRID)
# ===============================

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/email_service.py
# Description: SMTP host used when sending notification email through SMTP.
SMTP_HOST=

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/email_service.py
# Description: SMTP port for outbound email delivery.
SMTP_PORT=587

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/email_service.py
# Description: SMTP username used to authenticate with the mail server.
SMTP_USERNAME=

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/email_service.py
# Description: SMTP password used to authenticate with the mail server.
SMTP_PASSWORD=

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/email_service.py
# Description: Sender email address for outbound notifications.
SMTP_FROM_EMAIL=

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/email_service.py
# Description: Enable STARTTLS for SMTP connections.
SMTP_USE_TLS=true

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/email_service.py
# Description: SendGrid API key used as the preferred email provider when present.
SENDGRID_API_KEY=

# ===============================
# NOTIFICATIONS (VAPID)
# ===============================

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/push_service.py
# Description: Public VAPID key paired with the private key for Web Push.
VAPID_PUBLIC_KEY=

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/push_service.py
# Description: Private VAPID key used to sign Web Push notifications.
VAPID_PRIVATE_KEY=

# OPTIONAL | used in: apps/backend/core/config.py, apps/backend/services/push_service.py
# Description: VAPID subject/contact claim.
VAPID_SUBJECT=mailto:notifications@example.com

# ===============================
# DEV / OPTIONAL
# ===============================

# OPTIONAL | used in: apps/backend/docker/backend-entrypoint.sh
# Description: Run Alembic migrations automatically on backend container startup.
RUN_MIGRATIONS=true

# OPTIONAL | used in: apps/backend/docker/backend-entrypoint.sh
# Description: Number of attempts to wait for PostgreSQL before startup fails.
DB_WAIT_RETRIES=30

# OPTIONAL | used in: apps/backend/docker/backend-entrypoint.sh
# Description: Seconds to wait between PostgreSQL readiness checks.
DB_WAIT_SLEEP_SECONDS=2

# OPTIONAL | used in: apps/backend/core/config.py
# Description: Deprecated local upload directory fallback; Supabase Storage is preferred.
REPORT_UPLOAD_DIR=uploads/reports

# OPTIONAL | used in: apps/backend/workers/emergency_worker.py
# Description: Background emergency scan interval in seconds; clamped between 60 and 300.
EMERGENCY_CHECK_INTERVAL_SECONDS=60

# OPTIONAL | used in: apps/backend/services/emergency_engine/emergency_engine.py
# Description: Minutes to suppress repeat critical emergency alerts for the same user.
EMERGENCY_ALERT_RATE_LIMIT_MINUTES=15

# OPTIONAL | used in: apps/backend/services/chat_service.py
# Description: Enable writing grounded chat examples for later LoRA training.
CHAT_TRAINING_LOG_ENABLED=true

# OPTIONAL | used in: apps/backend/services/chat_service.py
# Description: Maximum retained chat training log entries.
CHAT_TRAINING_LOG_MAX_ENTRIES=5000

# OPTIONAL | used in: apps/backend/services/chat_service.py
# Description: Path to chat training log JSON.
CHAT_TRAINING_LOG_PATH=data/chat_training_logs.json

# OPTIONAL | used in: apps/backend/services/chat_service.py
# Description: Path to LoRA chat dataset JSON.
CHAT_LORA_DATASET_PATH=data/chat_lora_training.json

# OPTIONAL | used in: pipelines/llm_pipeline/train_lora.py
# Description: Base Hugging Face model used when training the optional LoRA adapter.
LORA_BASE_MODEL=TinyLlama/TinyLlama-1.1B-Chat-v1.0
